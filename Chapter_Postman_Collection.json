				"url": {
					"raw": "{{base_url}}/api/v1/content-builder/chapters/{{chapter_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"content-builder",
						"chapters",
						"{{chapter_id}}"
					]
				}
			},
			"response": []
