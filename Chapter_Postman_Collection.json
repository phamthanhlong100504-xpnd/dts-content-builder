	"item": [
		{
			"name": "1. Create Draft Chapter",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Chapter 1: Introduction\",\n    \"metadata\": {\n        \"duration_minutes\": 45\n    }\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/content-builder/chapters/draft",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"content-builder",
						"chapters",
						"draft"
					]
				}
			},
			"response": []
		},
		{
