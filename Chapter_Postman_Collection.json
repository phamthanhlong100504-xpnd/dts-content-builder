				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Chapter 2: Advanced Topics\",\n    \"metadata\": {},\n    \"questionBlocks\": [\n        {\n            \"questionId\": \"123e4567-e89b-12d3-a456-426614174000\",\n            \"title\": \"Section 1 Quiz\",\n            \"sortOrder\": 0\n        }\n    ]\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/content-builder/chapters/published",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"content-builder",
						"chapters",
						"published"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. List Chapters",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/content-builder/chapters?keyword=Chapter&status=DRAFT&page=0&size=20",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"content-builder",
						"chapters"
					],
					"query": [
						{
							"key": "keyword",
							"value": "Chapter"
						},
						{
							"key": "status",
							"value": "DRAFT"
						},
						{
							"key": "page",
							"value": "0"
						},
						{
							"key": "size",
							"value": "20"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Get Chapter Detail",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/content-builder/chapters/{{chapter_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"content-builder",
						"chapters",
						"{{chapter_id}}"
					]
				}
			},
			"response": []
		},
