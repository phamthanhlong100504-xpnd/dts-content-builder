						"value": "Bearer {{jwt_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"Chapter 1: Updated Introduction\",\n    \"status\": \"PUBLISHED\",\n    \"metadata\": {}\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/content-builder/chapters/{{chapter_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
